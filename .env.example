# ============================================================================
# TravelTok AI - Environment Variables
#
# Copy this file to `.env` at the repository root and fill in your values.
#   Windows:  copy .env.example .env
#   Unix/macOS: cp .env.example .env
#
# NEVER commit real secrets. This file only contains placeholders.
# The frontend also needs apps/web/.env.local (see apps/web/.env.example).
# ============================================================================

# --- General ---
NODE_ENV=development
PORT=3001

# --- PostgreSQL (used by Prisma CLI and the backend) ---
# Matches docker-compose.yml defaults for local development.
# Set DATABASE_SSL=true only when connecting to managed/cloud PostgreSQL.
DATABASE_URL=postgresql://traveltok:traveltok@localhost:5432/traveltok_ai?schema=public
DATABASE_SSL=false

# --- Redis (queues + cache) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate a strong secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to boot with a secret shorter than 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Email (Gmail SMTP - no domain purchase required) ---
# Uses Gmail App Password (2FA must be enabled first; see README).
# When unset, verification/reset links are logged to the console only.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=

# --- CORS ---
# Comma-separated origins allowed to call the API. Missing or "*" reflects any
# origin (dev only). In production list the web app origin explicitly.
CORS_ORIGINS=

# --- Rate limiting (per IP) ---
# Global limit; auth routes are stricter (10/min) and can't be overridden
# per-route. RATE_LIMIT_DISABLED=true is only for the e2e suite.
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_DISABLED=false

# --- AI providers (backend only - never expose to the browser) ---
# AI_MODE is the server default for AI generation:
#   mock (default) -> deterministic offline heuristics, no credentials needed
#   openai         -> real OpenAI structured output (requires OPENAI_API_KEY)
#   gemini         -> real Google Gemini output (requires GEMINI_API_KEY)
# Users can still pick a provider in the UI; the pick only sticks when the
# matching key is configured here. Semantic-search embeddings follow AI_MODE
# (Gemini -> gemini-embedding-001, 3072 dims; OpenAI -> text-embedding-3-small).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated Gemini text models users can pick in the "AI Engine" sidebar
# panel. Each model has its own free-tier daily quota, so rotating models keeps
# generation working when one model is exhausted. Empty -> config default list.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro,gemini-flash-latest,gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_MODE=mock

# --- Apify (backend only - never expose to the browser) ---
# The TikTok actor ID is configurable; leave blank until configured.
# SCRAPING_MODE controls the scraping backend for the BullMQ worker:
#   mock (default) -> deterministic mock data, no credentials needed
#   apify         -> real Apify run (requires token + actor id)
APIFY_API_TOKEN=
APIFY_TIKTOK_ACTOR_ID=
SCRAPING_MODE=mock

# --- Frontend (public URL of the API, safe to expose) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Docker Compose (PostgreSQL container) ---
# Local development defaults only. Use real secrets for any other environment.
POSTGRES_USER=traveltok
POSTGRES_PASSWORD=traveltok
POSTGRES_DB=traveltok_ai

# --- Analytics engine tuning (internal heuristics, weights are configurable) ---
TREND_WEIGHT_GROWTH=0.30
TREND_WEIGHT_ENGAGEMENT=0.25
TREND_WEIGHT_FREQUENCY=0.20
TREND_WEIGHT_RECENCY=0.15
TREND_WEIGHT_CONTENT_GAP=0.10
