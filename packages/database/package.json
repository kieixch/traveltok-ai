{
  "name": "@traveltok/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma client and shared database services for TravelTok AI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
