{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-e2e.ts"],
  "forceExit": true,
  "testTimeout": 30000,
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@traveltok/database$": "<rootDir>/../../packages/database/src/index.ts",
    "^@traveltok/ai$": "<rootDir>/../../packages/ai/src/index.ts",
    "^@traveltok/types$": "<rootDir>/../../packages/types/src/index.ts"
  }
}
