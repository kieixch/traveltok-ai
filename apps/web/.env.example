# Copy this file to `apps/web/.env.local` and adjust for your environment.
# These variables are mirrored in the root `.env.example`.

# Base URL of the TravelTok AI backend (public, safe to expose).
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Email (auth: email verification / password reset via Brevo) ---
# https://www.brevo.com — free plan: 300 emails/day, HTTPS API (no domain
# purchase needed; the sender email is verified by clicking a link Brevo sends).
# When unset, verification/reset links are logged to the console instead of
# being sent (dev fallback; flows don't fail).
BREVO_API_KEY=
# A sender address created & verified in Brevo (Settings > Senders & IP).
BREVO_SENDER_EMAIL=
# Optional display name shown as the sender (defaults to "Traveltok AI").
BREVO_SENDER_NAME=Traveltok AI