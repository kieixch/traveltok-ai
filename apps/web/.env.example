# Copy this file to `apps/web/.env.local` and adjust for your environment.
# These variables are mirrored in the root `.env.example`.

# Base URL of the TravelTok AI backend (public, safe to expose).
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Email (auth: email verification / password reset via Gmail SMTP) ---
# No domain purchase needed. Uses a regular Gmail address with an "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# When EMAIL_USER / EMAIL_APP_PASSWORD are unset, verification/reset links are
# logged to the console instead of being sent (dev fallback; flows don't fail).
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Optional sender display. Defaults to "Traveltok AI <EMAIL_USER>" when unset.
EMAIL_FROM=