# Copy this file to `apps/web/.env.local` and adjust for your environment.
# These variables are mirrored in the root `.env.example`.

# Base URL of the TravelTok AI backend (public, safe to expose).
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Email (auth: email verification / password reset via Resend) ---
# https://resend.com — get an API key, then set it here (server only).
# When RESEND_API_KEY is unset, verification/reset links are logged to the
# console instead of being sent (dev fallback; flows don't fail).
RESEND_API_KEY=
# Sender address. Defaults to Resend's onboarding sandbox address when unset;
# a real sender must be verified in your Resend account for production.
EMAIL_FROM=Traveltok AI <onboarding@resend.dev>
